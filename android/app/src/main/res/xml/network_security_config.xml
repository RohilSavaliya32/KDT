<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for development API -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">193.46.198.103</domain>
        <domain includeSubdomains="true">kdtdiamond.com</domain>
        <domain includeSubdomains="true">www.kdtdiamond.com</domain>
    </domain-config>

    <!-- Default configuration for all other domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>